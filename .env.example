# Model Provider (Phase 1: openrouter, Phase 2+: bedrock)
MODEL_PROVIDER=openrouter

# OpenRouter credentials — used for both generation and embeddings
OPENROUTER_API_KEY=
# Generation model (read as GENERATION_MODEL; OPENROUTER_MODEL_ID also accepted).
# google/gemma-4-31b-it:free is $0 but frequently rate-limited (429) upstream —
# unreliable for a live demo. z-ai/glm-5.2 is a cheap, reliable paid alternative
# (OpenRouter auto-fails-over across providers hosting it). This var MUST be
# set in the deployment environment.
GENERATION_MODEL=z-ai/glm-5.2

# Bedrock credentials (Phase 2+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Embedding model (MUST match vector(N) dimension in init-db.sql)
# Phase 1 — OpenRouter text-embedding-3-small: dimension = 1536
# Phase 2 — Bedrock Titan Embeddings V2:        dimension = 1024
# Phase 2 — Bedrock Cohere Embed:               dimension = 1024
# Changing this requires dropping and rebuilding the documents table.
EMBEDDING_MODEL=text-embedding-3-small

# Database
# Option 1: Railway PostgreSQL plugin (demo/production)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<railway-host>:5432/railway

# Option 2: Neon free tier (local dev)
# DATABASE_URL=postgresql+asyncpg://neon_user:<password>@<neon-host>/neon_db

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reg-intel-agent
LANGSMITH_TRACING_V2=true

# Ticket backend — "github" (default) or "jira"
TICKET_BACKEND=github

# GitHub (used when TICKET_BACKEND=github)
GITHUB_TOKEN=
GITHUB_REPO=faiz-faruqi/reg-intel-agent

# Jira Cloud (used when TICKET_BACKEND=jira)
# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=COMP

# Application
PORT=8000          # local dev only — Railway overrides this with its own $PORT (8080)
API_PORT=8001      # host port mapped to PORT in docker-compose (change if 8001 is taken)
DEBUG=false

# ── Authentication (session-based, no database) ───────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# Demo credentials for the sign-in page
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Leave blank to disable the access-code gate; set a value to require it
DEMO_ACCESS_CODE=EARIG2026

# Session lifetime in seconds (default: 86400 = 24 hours)
SESSION_MAX_AGE=86400
