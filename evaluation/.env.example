AGENT_BASE_URL=https://reg-intel.demo.cloudkraft.com
AGENT_QUERY_PATH=/query
AGENT_MODEL_LABEL=OpenRouter/GLM-5.2
OPENROUTER_API_KEY=<your OpenRouter key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=openai/gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# The Agent gates /query behind a login session — must match its deployed
# DEMO_USERNAME / DEMO_PASSWORD / DEMO_ACCESS_CODE env vars.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_ACCESS_CODE=<access code>
