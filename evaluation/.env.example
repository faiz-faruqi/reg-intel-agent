AGENT_BASE_URL=https://reg-intel.demo.cloudkraft.com
AGENT_QUERY_PATH=/query
AGENT_MODEL_LABEL=OpenRouter/GLM-5.2
OPENROUTER_API_KEY=<your OpenRouter key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=openai/gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# The Agent gates /query behind a login session — DEMO_USERNAME/DEMO_PASSWORD
# must match its deployed values. Access codes are now time-limited and
# generated on demand (see scripts/generate_access_code.py in the main repo) —
# generate one against the target deployment and paste it in below before
# running the eval; it must still be unexpired when this runs.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_ACCESS_CODE=<a currently-valid generated access code>
